# Trigger Email from Firestore - sends the documents written to `mail`.
# The SMTP password is NOT here: it lives in Google Secret Manager. To change it,
# add a new version of the secret, update the version number below, then
# run: firebase deploy --only extensions
DATABASE=(default)
DATABASE_REGION=europe-west1
AUTH_TYPE=UsernamePassword
SMTP_CONNECTION_URI=smtps://fleet%40spinkano.com.ng@mail.spinkano.com.ng:465
SMTP_PASSWORD=projects/285522850455/secrets/firestore-send-email-SMTP_PASSWORD/versions/3
MAIL_COLLECTION=mail
DEFAULT_FROM=SPIN KN Fleet Management <fleet@spinkano.com.ng>
DEFAULT_REPLY_TO=fleet@spinkano.com.ng
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
firebaseextensions.v1beta.function/location=europe-west1
