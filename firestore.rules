rules_version = '2';

// Reads are split by role. Almost every write goes through Cloud Functions,
// which enforce the workflow rules in transactions. The only direct client
// writes are admin edits to vehicles/settings and drivers queueing their own
// actions (which works offline and is applied by a trigger).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function ready() { return signedIn() && request.auth.token.mustChangePassword != true; }
    // 'super' holds both office roles (admin + SPC).
    function isAdmin() { return ready() && role() in ['admin', 'super']; }
    function isOffice() { return ready() && role() in ['admin', 'spc', 'super']; }
    function isDriver() { return ready() && role() == 'driver'; }
    function mine() { return resource.data.driverId == request.auth.uid; }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOffice() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /staff/{id} {
      allow read: if isOffice();
      allow write: if false;
    }

    // QR tokens are credentials: admin only.
    match /staffSecrets/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /drivers/{id} {
      allow read: if isOffice() || (isDriver() && request.auth.uid == id);
      allow write: if false;
    }

    match /vehicles/{id} {
      allow read: if isOffice() || isDriver();
      allow write: if false;   // vehicleSave / vehicleCondition / vehicleServiced
    }

    match /tasks/{id} {
      allow read: if isOffice() || (isDriver() && mine());
      allow write: if false;
    }

    match /trips/{id} {
      allow read: if isOffice() || (isDriver() && mine());
      allow write: if false;
    }

    match /fuel/{id} {
      allow read: if isOffice() || (isDriver() && mine());
      allow write: if false;
    }

    match /maintenance/{id} {
      allow read: if isOffice();
      allow write: if false;
    }

    match /requests/{id} {
      allow read: if isOffice();
      allow write: if false;
    }

    // Driver action queue. Created offline by the Firestore SDK, applied in
    // order by the onDriverAction trigger. Clients can never edit or delete.
    match /driverActions/{id} {
      allow read: if isAdmin() || (isDriver() && mine());
      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.state == 'pending'
        && request.resource.data.keys().hasOnly(['driverId', 'type', 'ts', 'seq', 'payload', 'state', 'createdAt'])
        && request.resource.data.type in ['trip.start', 'trip.stop', 'trip.resume', 'trip.end', 'fuel.add', 'task.ack']
        && request.resource.data.seq is number
        && request.resource.data.ts is string
        && request.resource.data.payload is map;
      allow update, delete: if false;
    }

    match /logs/{id} {
      allow read: if isOffice();
      allow write: if false;
    }

    // Outgoing email (Trigger Email extension).
    match /mail/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
